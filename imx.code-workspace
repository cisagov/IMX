{
  "folders": [
    { "name": "root", "path": "." },
    { "path": "imx-client" },
    { "path": "imx-server" },
    { "path": "imx-py" },
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:imx-py}/.venv/bin/python",
    "python.analysis.extraPaths": ["${workspaceFolder:imx-py}"],
    "eslint.workingDirectories": [
      { "pattern": "./imx-client/" },
      { "pattern": "./imx-server/" },
    ],
    "eslint.validate": ["javascript", "typescript"],
  },
  "extensions": {
    "recommendations": [
      "ms-vscode-remote.remote-containers",
      "hverlin.mise-vscode",
      "ms-python.python",
      "charliermarsh.ruff",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "exiasr.hadolint",
      "tamasfe.even-better-toml",
      "redhat.vscode-yaml",
    ],
  },
}
