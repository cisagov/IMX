                  "patternProperties": {
                    "^[a-zA-Z0-9_-]{0,250}$": {
                      "anyOf": [
                        {
                          "type": "array",
                          "minItems": 1
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "object"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "description": "Specifies any options (SO_*) that may be used by the socket, as a dictionary.",
              "patternProperties": {
                "^(SO|ICMP|ICMP6|IP|IPV6|MCAST|TCP|IRLMP)(_[A-Z]+)+$": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "socket_type": {
