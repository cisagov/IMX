                                    },
                                    {
                                        "$ref": "https://raw.githubusercontent.com/oasis-open/cti-stix2-json-schemas/stix2.1/schemas/common/cyber-observable-core.json"
                                    }
                                ]
                            },
                            {
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "description": "The type of this object, which for custom objects cannot be one of those defined in the specification.",
                                        "not": {
                                            "enum": [
                                                "attack-pattern",
                                                "campaign",
                                                "course-of-action",
                                                "identity",
                                                "indicator",
                                                "infrastructure",
                                                "intrusion-set",
                                                "malware",
                                                "observed-data",
                                                "relationship",
                                                "report",
                                                "sighting",
                                                "threat-actor",
                                                "tool",
                                                "vulnerability",
                                                "artifact",
                                                "autonomous-system",
                                                "directory",
                                                "domain-name",
                                                "email-addr",
                                                "email-message",
                                                "file",
                                                "ipv4-addr",
                                                "ipv6-addr",
                                                "mac-addr",
                                                "mutex",
                                                "network-traffic",
                                                "process",
                                                "software",
                                                "url",
                                                "user-account",
                                                "windows-registry-key",
                                                "x509-certificate",
                                                "language-content",
                                                "marking-definition"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                ]
            },
            "minItems": 1
        }
    },
    "required": ["type", "id"]
}
