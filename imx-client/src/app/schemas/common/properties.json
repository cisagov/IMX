{
  "$id": "https://raw.githubusercontent.com/oasis-open/cti-stix2-json-schemas/stix2.1/schemas/common/properties.json",
  "$schema": "http://json-schema.org/draft/2020-12/schema#",
  "title": "properties",
  "description": "Rules for custom properties",
  "patternProperties": {
    "^[a-z][a-z0-9_]{0,245}_bin$": {
      "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)$"
    },
    "^[a-z][a-z0-9_]{0,245}_hex$": {
      "pattern": "^([a-fA-F0-9]{2})+$"
    },
    "^([a-z][a-z0-9_]{2,249})|id$": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false
}
