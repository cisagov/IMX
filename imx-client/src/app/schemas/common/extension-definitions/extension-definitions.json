                                        "enum": ["property-extension"]
                                    },
                                    "pap": {
                                        "type": "string",
                                        "enum": ["white"]
                                    }
                                },
                                "required": ["extension_type", "pap"],
                                "additionalProperties": false
                            }
                        },
                        "required": ["extension-definition--f8d78575-edfd-406e-8e84-6162a8450f5b"],
