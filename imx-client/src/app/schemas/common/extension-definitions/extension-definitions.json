    "extension-definition--d57b7c9c-7fa6-436b-b82c-8e6f69cdc3d0":{
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://raw.githubusercontent.com/oasis-open/cti-stix-common-objects/main/extension-definition-specifications/malware-behavior-8e9/extension-definition--d57b7c9c-7fa6-436b-b82c-8e6f69cdc3d0.json",
        "title": "Malware Behavior Extension",
        "description": "This schema defines new SDOs to capture malware behaviors.",
        "allOf": [
            {
                "oneOf": [
                {
                    "$ref": "https://raw.githubusercontent.com/oasis-open/cti-stix-common-objects/main/extension-definition-specifications/malware-behavior-8e9/malware-behavior.json"
                },
                {
                    "$ref": "https://raw.githubusercontent.com/oasis-open/cti-stix-common-objects/main/extension-definition-specifications/malware-behavior-8e9/malware-method.json"
                },
                {
                    "$ref": "https://raw.githubusercontent.com/oasis-open/cti-stix-common-objects/main/extension-definition-specifications/malware-behavior-8e9/malware-objective.json"
                }
                ]
            },
            {
                "properties": {
                    "extensions": {
                        "type": "object",
                        "properties": {
                            "extension-definition--d57b7c9c-7fa6-436b-b82c-8e6f69cdc3d0": {
                                "type": "object",
                                "properties": {
                                    "extension_type": {
                                        "type": "string",
                                        "description": "MBC SDOs.",
                                        "enum": ["new-sdo"]
                                    }
                                },
                                "required": ["extension_type"]
                            }
                        },
                        "required": ["extension-definition--d57b7c9c-7fa6-436b-b82c-8e6f69cdc3d0"]
                    }
                }
            }
        ]
    }
}
