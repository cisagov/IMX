{
  "name": "devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "mise trust && mise install",
  "postStartCommand": "mise run install",
  "customizations": {
    "vscode": {
      "extensions": [
        "hverlin.mise-vscode",
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "exiasr.hadolint",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ]
    }
  }
}
